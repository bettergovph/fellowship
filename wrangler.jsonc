// Static assets on a Worker, served at fellowship.bettergov.ph. Build first: `npm run build`.
{
  "name": "bettergov-fellowship",
  "compatibility_date": "2025-12-26",
  "assets": {
    "directory": "./dist/static",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "fellowship.bettergov.ph", "custom_domain": true }]
}
